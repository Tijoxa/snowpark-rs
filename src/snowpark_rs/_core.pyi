from collections.abc import Callable, Iterable, Sequence
from decimal import Decimal

from polars import Expr

type BindValue = str | int | float | bool | Decimal | None

class Field:
    def __init__(
        self, name: str, data_type: str | None = None, nullable: bool | None = None
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def data_type(self) -> str | None: ...
    @property
    def nullable(self) -> bool | None: ...

class UnsupportedPolarsExpression(RuntimeError): ...

class _Frame:
    def __init__(
        self, name: str | Iterable[str], schema: list[Field] | None = None
    ) -> None: ...
    @property
    def schema(self) -> list[Field] | None: ...
    def polars_filter(
        self,
        exprs: Sequence[Expr],
        plugin_path: str,
        membership: Callable[[str], _Frame | None],
    ) -> _Frame: ...
    def polars_select(self, exprs: Sequence[Expr], plugin_path: str) -> _Frame: ...
    def polars_with_columns(
        self, exprs: Sequence[Expr], plugin_path: str
    ) -> _Frame: ...
    def polars_aggregate(
        self,
        keys: Sequence[Expr],
        exprs: Sequence[Expr],
        plugin_path: str,
    ) -> _Frame: ...
    def polars_sort(
        self,
        keys: Sequence[tuple[Expr, bool, bool]],
        plugin_path: str,
    ) -> _Frame: ...
    def polars_join_keys(self, keys: Sequence[Expr]) -> list[str]: ...
    def select_join_output(
        self, columns: list[tuple[str, str | None, str]]
    ) -> _Frame: ...
    def limit(self, n: int, offset: int) -> _Frame: ...
    def rename(self, names: list[tuple[str, str]]) -> _Frame: ...
    def distinct(self) -> _Frame: ...
    def union(
        self, other: _Frame, all: bool, by_name: bool, allow_missing: bool
    ) -> _Frame: ...
    def join(
        self, right: _Frame, keys: list[tuple[str, str]], how: str, nulls_equal: bool
    ) -> _Frame: ...
    def to_sql(self) -> tuple[str, list[BindValue]]: ...
