from collections.abc import Callable, Iterable, Iterator, Sequence
from typing import Concatenate

from ._session import Session, Table

type BindValue = str | int | bool

class Column:
    def alias(self, name: str) -> Projection: ...
    def eq(self, other: Column) -> Column: ...
    def ne(self, other: Column) -> Column: ...
    def lt(self, other: Column) -> Column: ...
    def le(self, other: Column) -> Column: ...
    def gt(self, other: Column) -> Column: ...
    def ge(self, other: Column) -> Column: ...
    def __and__(self, other: Column) -> Column: ...
    def __or__(self, other: Column) -> Column: ...
    def __invert__(self) -> Column: ...
    def is_null(self) -> Column: ...
    def is_not_null(self) -> Column: ...

class Projection: ...

class DataFrame:
    @staticmethod
    def table(name: str | Iterable[str]) -> DataFrame: ...
    def filter(self, predicate: Column) -> DataFrame: ...
    def select(self, projections: Sequence[str | Column | Projection]) -> DataFrame: ...
    def pipe[**P, T](
        self,
        function: Callable[Concatenate[DataFrame, P], T],
        *args: P.args,
        **kwargs: P.kwargs,
    ) -> T: ...
    def to_sql(self) -> tuple[str, list[BindValue]]: ...
    def to_arrow(self, session: Session) -> Table: ...
    def to_arrow_batches(self, session: Session) -> Iterator[Table]: ...

def col(name: str) -> Column: ...
def lit(value: BindValue) -> Column: ...
