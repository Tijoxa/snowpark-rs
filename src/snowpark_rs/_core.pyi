from collections.abc import Callable, Iterable, Iterator, Sequence
from decimal import Decimal
from typing import Concatenate, Literal, overload

from ._polars import PolarsDataFrame
from ._session import Session
from ._session import Table as ArrowTable

try:
    from pyarrow import Schema as ArrowSchema
except ImportError:
    from typing import Any as ArrowSchema

type BindValue = str | int | bool | Decimal | None
type Operand = Column | BindValue

class Column:
    def alias(self, name: str) -> Projection: ...
    def eq(self, other: Operand) -> Column: ...
    def ne(self, other: Operand) -> Column: ...
    def lt(self, other: Operand) -> Column: ...
    def le(self, other: Operand) -> Column: ...
    def gt(self, other: Operand) -> Column: ...
    def ge(self, other: Operand) -> Column: ...
    # Equality operators build SQL predicates.
    def __eq__(self, other: Operand) -> Column: ...  # ty: ignore[incompatible-method-override]
    def __ne__(self, other: Operand) -> Column: ...  # ty: ignore[incompatible-method-override]
    def __lt__(self, other: Operand) -> Column: ...
    def __le__(self, other: Operand) -> Column: ...
    def __gt__(self, other: Operand) -> Column: ...
    def __ge__(self, other: Operand) -> Column: ...
    def __bool__(self) -> bool: ...
    def __hash__(self) -> int: ...
    def asc(self) -> SortKey: ...
    def desc(self) -> SortKey: ...
    def asc_nulls_first(self) -> SortKey: ...
    def asc_nulls_last(self) -> SortKey: ...
    def desc_nulls_first(self) -> SortKey: ...
    def desc_nulls_last(self) -> SortKey: ...
    def __and__(self, other: Column) -> Column: ...
    def __or__(self, other: Column) -> Column: ...
    def __invert__(self) -> Column: ...
    def is_null(self) -> Column: ...
    def is_not_null(self) -> Column: ...
    def cast(self, to: str) -> Column: ...
    def __neg__(self) -> Column: ...
    def __add__(self, other: Operand) -> Column: ...
    def __radd__(self, other: Operand) -> Column: ...
    def __sub__(self, other: Operand) -> Column: ...
    def __rsub__(self, other: Operand) -> Column: ...
    def __mul__(self, other: Operand) -> Column: ...
    def __rmul__(self, other: Operand) -> Column: ...
    def __truediv__(self, other: Operand) -> Column: ...
    def __rtruediv__(self, other: Operand) -> Column: ...
    def __mod__(self, other: Operand) -> Column: ...
    def __rmod__(self, other: Operand) -> Column: ...
    def __pow__(self, other: Operand, modulo: None = None) -> Column: ...
    def __rpow__(self, other: Operand, modulo: None = None) -> Column: ...

class Field:
    def __init__(
        self, name: str, data_type: str | None = None, nullable: bool | None = None
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def data_type(self) -> str | None: ...
    @property
    def nullable(self) -> bool | None: ...

class Projection: ...
class SortKey: ...

type Aggregate = Column | Projection | tuple[str | Column, str]

class RelationalGroupedDataFrame:
    def agg(self, *exprs: Aggregate | Iterable[Aggregate] | dict[str, str]) -> DataFrame: ...

class DataFrame:
    @property
    def schema(self) -> list[Field] | None: ...
    @property
    def columns(self) -> list[str] | None: ...
    def schema_with_session(self, session: Session) -> ArrowSchema: ...
    def with_column(
        self, col_name: str, col: Column, *, keep_column_order: bool = False
    ) -> DataFrame: ...
    @overload
    def rename(self, col_or_mapper: Column | str, new_column: str) -> DataFrame: ...
    @overload
    def rename[K: Column | str](
        self, col_or_mapper: dict[K, str], new_column: None = None
    ) -> DataFrame: ...
    def distinct(self) -> DataFrame: ...
    def union(self, other: DataFrame) -> DataFrame: ...
    def union_all(self, other: DataFrame) -> DataFrame: ...
    def union_by_name(self, other: DataFrame, allow_missing_columns: bool = False) -> DataFrame: ...
    def union_all_by_name(
        self, other: DataFrame, allow_missing_columns: bool = False
    ) -> DataFrame: ...
    def filter(self, predicate: Column) -> DataFrame: ...
    def select(self, projections: Iterable[str | Column | Projection]) -> DataFrame: ...
    def col(self, col_name: str) -> Column: ...
    def __getitem__(self, name: str) -> Column: ...
    def group_by(
        self, *cols: str | Column | Projection | Iterable[str | Column | Projection]
    ) -> RelationalGroupedDataFrame: ...
    def agg(self, *exprs: Aggregate | Iterable[Aggregate] | dict[str, str]) -> DataFrame: ...
    def sort(
        self,
        *cols: str | Column | SortKey | Iterable[str | Column | SortKey],
        ascending: bool | int | Sequence[bool | int] | None = None,
    ) -> DataFrame: ...
    def limit(self, n: int, offset: int = 0) -> DataFrame: ...
    def join(
        self, right: DataFrame, on: Column, how: str = "inner", *, lsuffix: str = "", rsuffix: str = ""
    ) -> DataFrame: ...
    def pipe[**P, T](
        self,
        function: Callable[Concatenate[DataFrame, P], T],
        *args: P.args,
        **kwargs: P.kwargs,
    ) -> T: ...
    def to_sql(self) -> tuple[str, list[BindValue]]: ...
    def to_arrow(self, session: Session) -> ArrowTable: ...
    def to_arrow_batches(self, session: Session) -> Iterator[ArrowTable]: ...
    @overload
    def to_polars(
        self, session: Session, *, use_batches: Literal[False] = False
    ) -> PolarsDataFrame: ...
    @overload
    def to_polars(
        self, session: Session, *, use_batches: Literal[True]
    ) -> Iterator[PolarsDataFrame]: ...
    @overload
    def to_polars(
        self, session: Session, *, use_batches: bool
    ) -> PolarsDataFrame | Iterator[PolarsDataFrame]: ...

class Table(DataFrame):
    def __init__(self, name: str | Iterable[str], *, schema: Sequence[Field] | None = None) -> None: ...

def col(name: str) -> Column: ...
def lit(value: Operand, datatype: str | None = None) -> Column: ...
def lit_null(datatype: str) -> Column: ...

def count(e: str | Column) -> Column: ...
def sum(e: str | Column) -> Column: ...
